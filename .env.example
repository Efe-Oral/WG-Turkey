# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings > API
# Public, safe in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Use the service_role key or a secret key.
SUPABASE_SECRET_KEY=

# Public site address, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email through Resend. Without these, nothing is sent.
RESEND_API_KEY=
EMAIL_FROM=EvArkadaşıAra <bildirim@example.com>

# Cloudflare Turnstile bot protection. Without these the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the one-click "Yayında tut" email link. Use a long random value.
RENEW_TOKEN_SECRET=

# Protects /api/cron routes. Vercel sends it automatically when set there.
CRON_SECRET=

# Cookie-free web analytics: plausible or umami. Empty switches it off.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# Plausible: your domain. Umami: the website id.
NEXT_PUBLIC_ANALYTICS_SITE=

# Footer Instagram link. Leave empty until the account exists.
NEXT_PUBLIC_INSTAGRAM_URL=

# Shows "Google ile devam et". Enable after adding Google as a provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Serves /dev/ui in a production build. Keep unset on the live site.
ENABLE_DEV_UI=

# Phone verification before the first listing. Off at launch, see docs/decisions.md.
PHONE_VERIFICATION_ENABLED=false

# Dev seed safety: the seed script only runs against this exact project ref.
SEED_TARGET_REF=
