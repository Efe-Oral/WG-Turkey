# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings > API
# Public, safe in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public site address, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Footer Instagram link. Leave empty until the account exists.
NEXT_PUBLIC_INSTAGRAM_URL=

# Serves /dev/ui in a production build. Keep unset on the live site.
ENABLE_DEV_UI=

# Phone verification before the first listing. Off at launch, see docs/decisions.md.
PHONE_VERIFICATION_ENABLED=false

# Dev seed safety: the seed script only runs against this exact project ref.
SEED_TARGET_REF=
